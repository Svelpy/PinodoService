# =================================
# Formato (compatible con docker --env-file y Dokploy)
# =================================
# NOMBRE=valor, sin espacios alrededor del "=".
# Sin comillas: Docker las incluye como parte del valor.
# Comentarios solo en líneas propias, nunca al final de una línea.
# NOMBRE= vacío equivale a no definida.

# =================================
# Application
# =================================
APP_NAME=AdamGroupSRL
APP_VERSION=1.0.0
APP_DESCRIPTION=Api para AdamGroup, una plataforma ecommerce para un negocio de moda
# development | test | staging | production
ENVIRONMENT=development

# =================================
# PostgreSQL (Async SQLAlchemy + asyncpg)
# =================================
# Formato: postgresql+asyncpg://USUARIO:PASSWORD@HOST:PUERTO/BASE
# - Caracteres reservados del password codificados: @ -> %40, # -> %23, % -> %25
# - SSL: ?ssl=require (asyncpg no acepta ?sslmode=require)
# - Supabase: Session Pooler (puerto 5432), no el Transaction Pooler (6543)
# - API en Docker y PostgreSQL en el host: host.docker.internal, no localhost
# - Misma red Docker/Dokploy: nombre del servicio como host
# production -> DATABASE_URL | development, test, staging -> TEST_DATABASE_URL
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres
TEST_DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF_TEST:PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# =================================
# JWT (Authentication)
# =================================
# Ambas claves deben tener al menos 32 bytes y ser diferentes entre sí.
SECRET_KEY=tu_secret_key_aqui_minimo_32_bytes
CSRF_SECRET_KEY=tu_csrf_secret_key_aqui_minimo_32_bytes

# =================================
# Cloudinary (Video & Image Storage)
# =================================
CLOUDINARY_CLOUD_NAME=tu_cloudinary_cloud_name
CLOUDINARY_API_KEY=tu_cloudinary_api_key
CLOUDINARY_API_SECRET=tu_cloudinary_api_secret
# production -> CLOUDINARY_FOLDER_NAME_PRODUCTION | resto -> TEST_CLOUDINARY_FOLDER_NAME
CLOUDINARY_FOLDER_NAME_PRODUCTION=adamgroup
TEST_CLOUDINARY_FOLDER_NAME=adamgroup_test

# =================================
# CORS
# =================================
# development, test -> DEV_ORIGINS | staging, production -> PROD_ORIGINS
DEV_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
PROD_ORIGINS=https://svelpy.com

# =================================
# Initial Seed Data
# =================================
SEED_ADMIN_EMAIL_1=admin1@example.com
SEED_ADMIN_NAME_1=NombreAdmin1
SEED_ADMIN_LASTNAME_1=ApellidoAdmin1
SEED_ADMIN_PASSWORD_1=TuPasswordSeguro123

SEED_ADMIN_EMAIL_2=admin2@example.com
SEED_ADMIN_NAME_2=NombreAdmin2
SEED_ADMIN_LASTNAME_2=ApellidoAdmin2
SEED_ADMIN_PASSWORD_2=TuPasswordSeguro123

SEED_ADMIN_EMAIL_3=admin3@example.com
SEED_ADMIN_NAME_3=NombreAdmin3
SEED_ADMIN_LASTNAME_3=ApellidoAdmin3
SEED_ADMIN_PASSWORD_3=TuPasswordSeguro123

# Pixabay (solo seeds)
PIXABAY_API_KEY=
